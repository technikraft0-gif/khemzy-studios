---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { siteConfig } from "../data/site";
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = siteConfig.defaultImage,
  canonicalURL,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const pageURL = canonicalURL
  ? new URL(canonicalURL, siteUrl)
  : new URL(Astro.url.pathname, siteUrl);

const socialImage = image.startsWith("http")
  ? new URL(image)
  : new URL(image, siteUrl);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.url,
  logo: new URL("/favicon.svg", siteUrl).href,
  image: socialImage.href,
  description: siteConfig.description,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address,
    addressLocality: siteConfig.city,
    addressCountry: siteConfig.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 6.4474,
    longitude: 3.4723,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "09:00",
      closes: "18:00",
    },
  ],
  priceRange: "₦₦₦₦",
  sameAs: siteConfig.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101411" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={pageURL.href} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:url" content={pageURL.href} />
    <meta property="og:locale" content={siteConfig.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@khemzystudios" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/motion.js";
    </script>
  </body>
</html>
