---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import BookingForm from "../components/booking/BookingForm.astro";
import Icon from "../components/ui/Icon.astro";
import { siteConfig } from "../data/site";
import { studioFaqs } from "../data/faqs";

const defaultService = Astro.url.searchParams.get("service") ?? "";
const defaultPackage = Astro.url.searchParams.get("package") ?? "";
---

<BaseLayout
  title="Book a Session | Khemzy Studios"
  description="Commission Khemzy Studios for your wedding, portrait session, fashion editorial, or commercial campaign. Direct booking with transparent terms."
>
  <header class="booking-hero section">
    <div class="container">
      <SectionHeading
        eyebrow="RESERVATIONS & COMMISSIONS"
        title="Tell us about <em>your story.</em>"
        description="Whether you have an exact date or are exploring creative concepts, complete the inquiry form below and our studio management will craft a bespoke proposal."
      />
    </div>
  </header>

  <section class="section booking-content-section">
    <div class="container booking-layout">
      <div class="booking-form-col" data-reveal="up">
        <BookingForm
          defaultService={defaultService}
          defaultPackage={defaultPackage}
        />
      </div>

      <aside class="booking-info-col" data-reveal="left">
        <div class="info-card">
          <h3>The Khemzy Experience</h3>
          <ul class="experience-perks">
            <li>
              <Icon name="check" size={18} class="perk-icon" />
              <div>
                <strong>Curated Creative Moodboards</strong>
                <p>Every session begins with a personalized consultation to define lighting, color tone, and wardrobe.</p>
              </div>
            </li>
            <li>
              <Icon name="check" size={18} class="perk-icon" />
              <div>
                <strong>Artisanal Skin & Fabric Retouching</strong>
                <p>We honor authentic melanin skin textures and organic garment drapery with zero artificial plasticky filters.</p>
              </div>
            </li>
            <li>
              <Icon name="check" size={18} class="perk-icon" />
              <div>
                <strong>Private Archival Cloud Vault</strong>
                <p>Permanent high-resolution gallery access with unlimited full-fidelity downloads for you and family.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="info-card studio-direct-card">
          <h3>Prefer Immediate Dialogue?</h3>
          <p>You are welcome to connect with our studio director directly via phone or WhatsApp.</p>
          <div class="direct-contact-links">
            <a href={`tel:${siteConfig.phone}`} class="direct-link">
              <Icon name="phone" size={16} />
              <span>{siteConfig.phoneDisplay}</span>
            </a>
            <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="direct-link direct-link--wa">
              <Icon name="whatsapp" size={16} />
              <span>Chat via WhatsApp</span>
            </a>
            <a href={`mailto:${siteConfig.bookingEmail}`} class="direct-link">
              <Icon name="mail" size={16} />
              <span>{siteConfig.bookingEmail}</span>
            </a>
          </div>
          <span class="studio-loc">
            <Icon name="map-pin" size={14} /> {siteConfig.address}
          </span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section faqs-section">
    <div class="container faq-container">
      <div class="faq-header" data-reveal="up">
        <span class="eyebrow">BOOKING QUESTIONS</span>
        <h2>Frequently asked questions</h2>
      </div>

      <div class="faq-list" data-reveal-stagger>
        {studioFaqs.slice(0, 4).map((faq, index) => (
          <div class:list={["faq-item", { "is-open": index === 0 }]}>
            <button
              class="faq-trigger"
              type="button"
              aria-expanded={index === 0 ? "true" : "false"}
            >
              <span class="faq-question">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-content">
              <div class="faq-content-inner">
                <p>{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .booking-hero {
    padding-top: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-paper);
  }

  .booking-content-section {
    background: var(--color-paper);
    padding-top: 0;
  }

  .booking-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .booking-info-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-card {
    background: var(--color-paper-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem;
  }

  .info-card h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0 0 1.25rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }

  .experience-perks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experience-perks li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .perk-icon {
    color: var(--color-gold);
    margin-top: 0.2rem;
  }

  .experience-perks strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .experience-perks p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }

  .studio-direct-card {
    background: var(--color-ink);
    color: var(--color-white);
    border-color: var(--color-border-dark);
  }

  .studio-direct-card h3 {
    color: var(--color-white);
    border-bottom-color: var(--color-border-dark);
  }

  .studio-direct-card p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .direct-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-white);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .direct-link:hover {
    color: var(--color-gold);
  }

  .direct-link--wa {
    color: var(--color-gold);
    font-weight: 600;
  }

  .studio-loc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    border-top: 1px solid var(--color-border-dark);
    padding-top: 1rem;
  }

  .faqs-section {
    background: var(--color-paper-light);
    border-top: 1px solid var(--color-border);
  }

  .faq-container {
    max-width: 850px;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .faq-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 1.75rem;
    background: none;
    border: none;
    text-align: left;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
  }

  .faq-icon {
    font-size: 1.5rem;
    color: var(--color-gold);
  }

  .faq-content-inner {
    padding: 0 1.75rem 1.5rem;
  }

  .faq-content-inner p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (max-width: 950px) {
    .booking-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
