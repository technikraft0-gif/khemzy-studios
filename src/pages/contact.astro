---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Icon from "../components/ui/Icon.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="Contact the Studio | Khemzy Studios"
  description="Connect with Khemzy Studios in Lagos, Nigeria. Book appointments, request press kits, or explore creative collaborations."
>
  <header class="contact-hero section">
    <div class="container">
      <SectionHeading
        eyebrow="GET IN TOUCH"
        title="We'd love to hear <em>your ideas.</em>"
        description="Whether you have questions about scheduling a session, commercial assignments, destination travel, or studio appointments in Lagos, our doors are open."
      />
    </div>
  </header>

  <section class="section contact-main-section">
    <div class="container contact-grid">
      <div class="contact-info-cards" data-reveal="right">
        <div class="contact-card">
          <div class="card-icon">
            <Icon name="map-pin" size={24} />
          </div>
          <h3>Lagos Studio</h3>
          <p>{siteConfig.address}</p>
          <span class="sub-note">Sessions & consultations by appointment only.</span>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <Icon name="phone" size={24} />
          </div>
          <h3>Direct Dialogue</h3>
          <p>
            <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a>
          </p>
          <p>
            <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="wa-text-link">
              Chat on WhatsApp Directly →
            </a>
          </p>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <Icon name="mail" size={24} />
          </div>
          <h3>Electronic Mail</h3>
          <p>General Inquiries: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
          <p>Commissions: <a href={`mailto:${siteConfig.bookingEmail}`}>{siteConfig.bookingEmail}</a></p>
        </div>

        <div class="contact-card">
          <div class="card-icon">
            <Icon name="clock" size={24} />
          </div>
          <h3>Studio Hours</h3>
          <p>{siteConfig.openingHours}</p>
          <span class="sub-note">Available 24/7 for urgent wedding & event inquiries.</span>
        </div>
      </div>

      <div class="contact-form-col" data-reveal="left">
        <div class="form-box">
          <h3>Send a Direct Message</h3>
          <p class="form-sub">Fill out the quick note below and our client coordinator will reach out promptly.</p>

          <form id="contact-form" class="direct-contact-form" novalidate>
            <div class="form-group">
              <label for="contact-name">Your Name <span class="req">*</span></label>
              <input type="text" id="contact-name" name="name" required placeholder="e.g. Tunde Balogun" />
              <span class="field-error" id="err-name"></span>
            </div>

            <div class="form-group">
              <label for="contact-email">Email Address <span class="req">*</span></label>
              <input type="email" id="contact-email" name="email" required placeholder="tunde@example.com" />
              <span class="field-error" id="err-email"></span>
            </div>

            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input type="text" id="contact-subject" name="subject" placeholder="e.g. Wedding inquiry / Press interview" />
            </div>

            <div class="form-group">
              <label for="contact-message">Message <span class="req">*</span></label>
              <textarea id="contact-message" name="message" rows="5" required placeholder="Write your message here..."></textarea>
              <span class="field-error" id="err-message"></span>
            </div>

            <button type="submit" class="button button--gold button--large contact-submit-btn">
              <span>Send Message</span>
              <span class="button-arrow" aria-hidden="true">↗</span>
            </button>
          </form>

          <div id="contact-success" class="contact-success-state" style="display: none;">
            <div class="success-icon">
              <Icon name="check" size={28} />
            </div>
            <h4>Thank You for Connecting</h4>
            <p>Your message has been received. We will respond within one business day.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const success = document.getElementById("contact-success");
    if (!form || !success) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      let valid = true;

      const name = (form.elements.namedItem("name") as HTMLInputElement).value;
      const email = (form.elements.namedItem("email") as HTMLInputElement).value;
      const msg = (form.elements.namedItem("message") as HTMLTextAreaElement).value;

      document.getElementById("err-name")!.textContent = "";
      document.getElementById("err-email")!.textContent = "";
      document.getElementById("err-message")!.textContent = "";

      if (!name || name.trim().length < 2) {
        document.getElementById("err-name")!.textContent = "Please enter your name.";
        valid = false;
      }

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        document.getElementById("err-email")!.textContent = "Please enter a valid email address.";
        valid = false;
      }

      if (!msg || msg.trim().length < 6) {
        document.getElementById("err-message")!.textContent = "Please write a brief message.";
        valid = false;
      }

      if (!valid) return;

      const btn = form.querySelector(".contact-submit-btn") as HTMLButtonElement;
      btn.disabled = true;
      btn.querySelector("span")!.textContent = "Sending...";

      setTimeout(() => {
        form.style.display = "none";
        success.style.display = "block";
      }, 600);
    });
  }

  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>

<style>
  .contact-hero {
    padding-top: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-paper);
  }

  .contact-main-section {
    background: var(--color-paper);
    padding-top: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-info-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .contact-card {
    background: var(--color-paper-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-gold);
    display: grid;
    place-items: center;
    margin-bottom: 1.25rem;
  }

  .contact-card h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .contact-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }

  .contact-card a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    transition: color 200ms ease;
  }

  .contact-card a:hover {
    color: var(--color-gold);
  }

  .wa-text-link {
    color: var(--color-gold) !important;
    font-weight: 600 !important;
  }

  .sub-note {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-style: italic;
  }

  .form-box {
    background: var(--color-paper-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: var(--shadow-soft);
  }

  .form-box h3 {
    font-family: var(--font-display);
    font-size: 1.85rem;
    margin: 0 0 0.4rem;
  }

  .form-sub {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .direct-contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .req {
    color: var(--color-terracotta);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.9rem 1.1rem;
    font-size: 0.95rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    transition: border-color 200ms ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .field-error {
    font-size: 0.78rem;
    color: var(--color-terracotta);
    min-height: 1rem;
  }

  .contact-success-state {
    text-align: center;
    padding: 3rem 1rem;
  }

  .success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-ink);
    display: grid;
    place-items: center;
    margin-inline: auto;
    margin-bottom: 1.25rem;
  }

  .contact-success-state h4 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }

  .contact-success-state p {
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .contact-info-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
