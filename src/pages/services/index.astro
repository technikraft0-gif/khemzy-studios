---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import ServiceCard from "../../components/services/ServiceCard.astro";
import BookingCTA from "../../components/home/BookingCTA.astro";
import { servicesData } from "../../data/services";
import { studioFaqs } from "../../data/faqs";

const processSteps = [
  {
    step: "01",
    title: "Discovery & Creative Dialogue",
    description:
      "We begin with a conversation about your intentions, aesthetic influences, and desired mood. Together we curate a tailored moodboard, wardrobe palette, and call sheet.",
  },
  {
    step: "02",
    title: "The Session & Lighting Direction",
    description:
      "On set, we create a calm, supportive environment. Through precise continuous lighting, posing guidance, and collaborative review, we capture your genuine presence without rush.",
  },
  {
    step: "03",
    title: "Artisanal Post-Production",
    description:
      "Every frame undergoes hand-guided color grading and subtle frequency-separation skin retouching that preserves organic texture while perfecting tone and atmosphere.",
  },
  {
    step: "04",
    title: "Heirloom Delivery & Archiving",
    description:
      "Your private cloud gallery is unlocked with full commercial or personal usage rights. Physical heirloom albums and museum-grade prints are handcrafted and delivered directly.",
  },
];
---

<BaseLayout
  title="Services & Creative Capabilities | Khemzy Studios"
  description="Explore our specialized photography disciplines: Weddings & Celebrations, Editorial Branding Portraits, Fashion Lookbooks, and Commercial Product Imagery."
>
  <header class="services-hero-header section">
    <div class="container">
      <SectionHeading
        eyebrow="STUDIO DISCIPLINES"
        title="Intentional photography. <em>Bespoke craft.</em>"
        description="We approach every assignment—from an intimate 90-minute studio portrait to a multi-day coastal wedding—with the same obsession for cinematic lighting, authentic composition, and emotional resonance."
      />
    </div>
  </header>

  <section class="section process-section">
    <div class="container">
      <div class="process-heading" data-reveal="up">
        <span class="eyebrow eyebrow--light">THE KHEMZY METHOD</span>
        <h2>How we bring your story <em>to life.</em></h2>
      </div>

      <div class="process-grid" data-reveal-stagger>
        {processSteps.map((step) => (
          <div class="process-step interactive-card">
            <span class="step-num">{step.step}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section services-list-section">
    <div class="container">
      <div class="services-list-intro" data-reveal="fade">
        <span class="eyebrow">OUR SPECIALIZATIONS</span>
        <h2>Detailed Service Offerings</h2>
      </div>

      <div class="services-cards-wrapper">
        {servicesData.map((service, index) => (
          <ServiceCard service={service} index={index} />
        ))}
      </div>
    </div>
  </section>

  <section class="section faqs-section">
    <div class="container faq-container">
      <div class="faq-header" data-reveal="up">
        <span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span>
        <h2>Everything you need <em>to know.</em></h2>
        <p>
          Have questions about deposits, location travel, turnaround time, or wardrobe guidance?
          Find answers below or message us directly.
        </p>
      </div>

      <div class="faq-list" data-reveal-stagger>
        {studioFaqs.map((faq, index) => (
          <div class:list={["faq-item", { "is-open": index === 0 }]}>
            <button
              class="faq-trigger"
              type="button"
              aria-expanded={index === 0 ? "true" : "false"}
            >
              <span class="faq-question">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-content">
              <div class="faq-content-inner">
                <p>{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA
    eyebrow="READY TO COMMISSION?"
    title="Let's build your <em>photographic archive.</em>"
    description="Select your desired service, tell us your proposed dates and location, and our studio management will reply within 24 business hours."
  />
</BaseLayout>

<style>
  .services-hero-header {
    padding-top: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-paper);
  }

  .process-section {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .process-heading {
    max-width: 650px;
    margin-bottom: 3.5rem;
  }

  .process-heading h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 500;
    margin: 0.75rem 0 0;
  }

  .process-heading h2 em {
    color: var(--color-gold);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .process-step {
    padding: 2.25rem 1.75rem;
    background: var(--color-ink-soft);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-gold);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.85rem;
    line-height: 1.3;
    color: var(--color-white);
  }

  .step-desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
  }

  .services-list-section {
    background: var(--color-paper);
  }

  .services-list-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 2rem;
  }

  .faqs-section {
    background: var(--color-paper-light);
    border-top: 1px solid var(--color-border);
  }

  .faq-container {
    max-width: 900px;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .faq-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 0.5rem 0 1rem;
  }

  .faq-header h2 em {
    color: var(--color-gold);
  }

  .faq-header p {
    color: var(--color-text-muted);
    font-size: 1rem;
    max-width: 620px;
    margin-inline: auto;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    background: none;
    border: none;
    text-align: left;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    transition: color 200ms ease;
  }

  .faq-trigger:hover {
    color: var(--color-gold);
  }

  .faq-icon {
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-gold);
    font-weight: 400;
  }

  .faq-content-inner {
    padding: 0 1.75rem 1.5rem;
  }

  .faq-content-inner p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  @media (max-width: 990px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
