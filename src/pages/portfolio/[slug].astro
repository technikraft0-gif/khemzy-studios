---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import BookingCTA from "../../components/home/BookingCTA.astro";
import { portfolioProjects } from "../../data/portfolio";
import { getAdjacentProjects } from "../../lib/portfolio";
import type { Project } from "../../types";

export function getStaticPaths() {
  return portfolioProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { prev, next } = getAdjacentProjects(project.slug);
---

<BaseLayout
  title={`${project.title} — Case Study | Khemzy Studios`}
  description={project.excerpt}
  image={project.cover}
>
  <article class="project-article">
    <header class="project-header section">
      <div class="container">
        <a class="back-link" href="/portfolio/">
          <span>← Back to portfolio archive</span>
        </a>

        <div class="project-header-meta" data-reveal="fade">
          <span class="project-category-tag">{project.category}</span>
          <span class="meta-dot">·</span>
          <span>{project.year}</span>
          <span class="meta-dot">·</span>
          <span>{project.location}</span>
        </div>

        <h1 class="project-title" data-reveal="up">
          {project.title}
        </h1>

        <p class="project-excerpt" data-reveal="up">
          {project.excerpt}
        </p>

        {project.client && (
          <div class="project-client-badge">
            <span class="label">Client:</span>
            <strong>{project.client}</strong>
          </div>
        )}
      </div>
    </header>

    <div class="project-hero-media container" data-reveal="zoom">
      <div class="hero-image-frame interactive-image-wrap">
        <img
          src={project.cover}
          alt={project.title}
          fetchpriority="high"
          width="1800"
          height="1100"
        />
      </div>
    </div>

    <section class="section project-body">
      <div class="container project-body-grid">
        <div class="project-story" data-reveal="up">
          <span class="eyebrow">THE ASSIGNMENT</span>
          <h2>Images with intention and lasting gravity.</h2>
          <p>{project.description}</p>

          {project.testimonial && (
            <blockquote class="project-quote">
              <p>"{project.testimonial.quote}"</p>
              <footer>
                <cite>{project.testimonial.author}</cite>
                {project.testimonial.role && <span> · {project.testimonial.role}</span>}
              </footer>
            </blockquote>
          )}
        </div>

        <aside class="project-sidebar" data-reveal="left">
          {project.stats && project.stats.length > 0 && (
            <div class="sidebar-block stats-block">
              <h3>Key Highlights</h3>
              <div class="stats-list">
                {project.stats.map((stat) => (
                  <div class="stat-item">
                    <span class="stat-value">{stat.value}</span>
                    <span class="stat-label">{stat.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {project.deliverables && project.deliverables.length > 0 && (
            <div class="sidebar-block">
              <h3>Scope & Deliverables</h3>
              <ul class="deliverables-list">
                {project.deliverables.map((item) => (
                  <li>
                    <Icon name="check" size={16} class="check-icon" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="sidebar-cta">
            <Button href="/booking/" variant="gold" class="book-btn">
              Book a similar session
            </Button>
          </div>
        </aside>
      </div>
    </section>

    {project.gallery && project.gallery.length > 1 && (
      <section class="section gallery-section">
        <div class="container">
          <span class="eyebrow" data-reveal="up">CURATED FRAMES</span>
          <h2 class="gallery-heading" data-reveal="up">Visual Narrative</h2>

          <div class="gallery-grid" data-reveal-stagger>
            {project.gallery.slice(1).map((image, idx) => (
              <figure class="gallery-item interactive-image-wrap">
                <img
                  src={image}
                  alt={`${project.title} detail frame ${idx + 2}`}
                  loading="lazy"
                  width="1200"
                  height="800"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <nav class="project-pagination section">
      <div class="container pagination-inner">
        {prev && (
          <a class="pagination-link pagination-link--prev" href={`/portfolio/${prev.slug}/`}>
            <span class="pagination-sub">← Previous Project</span>
            <span class="pagination-title">{prev.title}</span>
          </a>
        )}

        {next && (
          <a class="pagination-link pagination-link--next" href={`/portfolio/${next.slug}/`}>
            <span class="pagination-sub">Next Project →</span>
            <span class="pagination-title">{next.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>

  <BookingCTA
    eyebrow="INSPIRED BY THIS WORK?"
    title="Ready to commission <em>your visual narrative?</em>"
    description="Contact our Lagos studio team today to discuss dates, creative treatment, and tailored packages."
  />
</BaseLayout>

<style>
  .project-header {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 200ms ease;
  }

  .back-link:hover {
    color: var(--color-gold);
  }

  .project-header-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .project-category-tag {
    color: var(--color-gold);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin: 0 0 1.5rem;
    max-width: 950px;
  }

  .project-excerpt {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 800px;
    margin: 0 0 1.5rem;
  }

  .project-client-badge {
    display: inline-flex;
    gap: 0.5rem;
    font-size: 0.95rem;
    padding: 0.45rem 1rem;
    background: var(--color-paper-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .project-client-badge .label {
    color: var(--color-text-muted);
  }

  .hero-image-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: var(--shadow-hover);
  }

  .hero-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-body-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .project-story h2 {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    line-height: 1.15;
    margin: 0.5rem 0 1.5rem;
  }

  .project-story p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .project-quote {
    padding: 2rem;
    background: var(--color-paper-light);
    border-left: 3px solid var(--color-gold);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 2.5rem 0;
  }

  .project-quote p {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .project-quote cite {
    font-weight: 600;
    font-style: normal;
    color: var(--color-gold);
  }

  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    background: var(--color-paper-light);
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .sidebar-block h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .stats-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gold);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .deliverables-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: var(--color-text);
  }

  .check-icon {
    color: var(--color-gold);
    margin-top: 0.15rem;
  }

  :global(.book-btn) {
    width: 100%;
    justify-content: center;
  }

  .gallery-section {
    background: var(--color-paper-light);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 3rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-ink);
    aspect-ratio: 4 / 3;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-pagination {
    background: var(--color-paper);
    padding-block: 4rem;
  }

  .pagination-inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    max-width: 45%;
  }

  .pagination-link--next {
    margin-left: auto;
    text-align: right;
  }

  .pagination-sub {
    font-size: 0.8rem;
    color: var(--color-gold);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .pagination-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    transition: color 200ms ease;
  }

  .pagination-link:hover .pagination-title {
    color: var(--color-gold);
  }

  @media (max-width: 850px) {
    .project-body-grid {
      grid-template-columns: 1fr;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .pagination-inner {
      flex-direction: column;
    }

    .pagination-link {
      max-width: 100%;
    }

    .pagination-link--next {
      text-align: left;
    }
  }
</style>
