---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Page Not Found | Khemzy Studios"
  description="The page you are looking for cannot be found. Explore our photography portfolio or return home."
  noindex={true}
>
  <section class="section error-section">
    <div class="container error-container" data-reveal="zoom">
      <span class="eyebrow">ERROR 404</span>
      <h1 class="error-title">
        This moment has <em>vanished.</em>
      </h1>
      <p class="error-desc">
        The story or frame you are seeking may have moved, expired, or never existed.
        Let us guide you back to our curated visual collections.
      </p>

      <div class="error-actions">
        <Button href="/" variant="gold" size="large">
          <span>Return to Homepage</span>
        </Button>
        <Button href="/portfolio/" variant="outline" size="large">
          <span>Explore Portfolio</span>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    min-height: 75vh;
    display: grid;
    place-items: center;
    background: var(--color-paper);
    text-align: center;
    padding-top: clamp(6rem, 12vw, 10rem);
  }

  .error-container {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 1rem 0 1.5rem;
  }

  .error-title em {
    color: var(--color-gold);
    font-style: italic;
  }

  .error-desc {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.75;
    margin: 0 0 2.5rem;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
</style>
