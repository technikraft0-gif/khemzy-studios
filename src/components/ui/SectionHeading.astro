
---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  theme?: "light" | "dark";
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  theme = "light",
} = Astro.props;
---

<div
  class:list={[
    "section-heading",
    `section-heading--${align}`,
    `section-heading--${theme}`,
  ]}
  data-reveal="up"
>
  <span class="eyebrow">{eyebrow}</span>
  <h2 set:html={title} />
  {description && <p>{description}</p>}
</div>
