---
import Button from "../ui/Button.astro";
import { siteConfig } from "../../data/site";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "LET'S MAKE IT MEMORABLE",
  title = "Your moment.<br /><em>Our creative vision.</em>",
  description = "Tell us what you are imagining. We'll collaborate with you to create photographs you'll want to keep for generations.",
} = Astro.props;
---

<section class="section closing-section">
  <div class="container closing-inner" data-reveal="up">
    <span class="eyebrow eyebrow--light">{eyebrow}</span>
    <h2 set:html={title} />
    <p>{description}</p>
    <div class="closing-actions">
      <Button href="/booking/" size="large">
        <span>Let's plan your session</span>
      </Button>
      <a
        class="button button--outline-light button--large"
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Instant WhatsApp Chat</span>
        <span class="button-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .closing-section {
    background: var(--color-ink);
    color: var(--color-white);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .closing-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(199, 167, 108, 0.12) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .closing-inner {
    max-width: 740px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 1.25rem 0 1.5rem;
  }

  .closing-inner h2 :global(em) {
    color: var(--color-gold);
    font-style: italic;
  }

  .closing-inner p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .button--outline-light {
    color: var(--color-white);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .button--outline-light:hover {
    color: var(--color-ink);
    background: var(--color-white);
    border-color: var(--color-white);
  }
</style>
