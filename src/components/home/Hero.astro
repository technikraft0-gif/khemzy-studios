
---
import Button from "../ui/Button.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-background">
    <img
      class="hero-image"
      src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=2200&q=85"
      alt="Expressive editorial portrait in warm studio lighting"
      fetchpriority="high"
      width="2200"
      height="1467"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-copy">
      <span class="eyebrow eyebrow--light" data-reveal="up">
        KHEMZY STUDIOS · VISUAL STORYTELLING
      </span>

      <h1 id="hero-title" class="hero-title">
        <span data-reveal="up" style="--reveal-delay: 100ms">
          Every moment
        </span>
        <span data-reveal="up" style="--reveal-delay: 220ms">
          deserves to be
        </span>
        <span class="hero-title-accent" data-reveal="up" style="--reveal-delay: 340ms">
          unforgettable.
        </span>
      </h1>

      <p class="hero-description" data-reveal="up" style="--reveal-delay: 450ms">
        Photography with feeling. From personal portraits to
        once-in-a-lifetime celebrations and ambitious brands,
        we turn meaningful moments into lasting visual stories.
      </p>

      <div class="hero-actions" data-reveal="up" style="--reveal-delay: 550ms">
        <Button href="/booking/" size="large">Book a session</Button>
        <a class="text-link text-link--light" href="/portfolio/">
          Explore our work
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="hero-side-note" aria-hidden="true">
      <span>PORTRAITS</span>
      <span>CELEBRATIONS</span>
      <span>FASHION</span>
      <span>BRANDS</span>
    </div>

    <a class="hero-scroll" href="#featured-work">
      <span class="scroll-indicator" aria-hidden="true"></span>
      <span>Discover the stories</span>
    </a>

    <div class="hero-index" aria-hidden="true">
      <span>01</span>
      <span class="hero-index-line"></span>
      <span>05</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: min(900px, 100svh);
    align-items: center;
    overflow: clip;
    color: var(--color-white);
    background: var(--color-ink);
    isolation: isolate;
  }

  .hero-background,
  .hero-overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    animation: hero-image-enter 1.4s var(--ease-out) both;
  }

  .hero-overlay {
    background:
      linear-gradient(
        90deg,
        rgba(11, 15, 12, 0.96) 0%,
        rgba(11, 15, 12, 0.86) 29%,
        rgba(11, 15, 12, 0.43) 59%,
        rgba(11, 15, 12, 0.1) 100%
      ),
      linear-gradient(
        0deg,
        rgba(11, 15, 12, 0.5) 0%,
        transparent 32%
      );
  }

  .hero-content {
    position: relative;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    padding-top: 9rem;
    padding-bottom: 7rem;
  }

  .hero-copy {
    max-width: 760px;
    padding-block: 3rem;
  }

  .hero-title {
    max-width: 760px;
    margin-block: 1.6rem 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7.6vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.99;
  }

  .hero-title > span {
    display: block;
  }

  .hero-title-accent {
    color: var(--color-gold-light);
    font-style: italic;
  }

  .hero-description {
    max-width: 480px;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(0.95rem, 1.3vw, 1.08rem);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .text-link span {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .text-link:hover span {
    transform: translate(3px, -3px);
  }

  .text-link--light {
    color: var(--color-white);
  }

  .hero-side-note {
    position: absolute;
    right: 0;
    bottom: 29%;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    writing-mode: vertical-rl;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.8rem;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .scroll-indicator {
    position: relative;
    width: 20px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-pill);
  }

  .scroll-indicator::after {
    position: absolute;
    top: 6px;
    left: 8px;
    width: 2px;
    height: 6px;
    background: var(--color-gold-light);
    border-radius: 2px;
    content: "";
    animation: scroll-dot 1.6s ease-in-out infinite;
  }

  .hero-index {
    position: absolute;
    right: 0;
    bottom: 3.2rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
  }

  .hero-index-line {
    width: 55px;
    height: 1px;
    background: var(--color-gold);
  }

  @keyframes hero-image-enter {
    from {
      opacity: 0.65;
      transform: scale(1.045);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes scroll-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(9px); opacity: 0.2; }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 790px;
      min-height: min(850px, 100svh);
    }

    .hero-image {
      object-position: 58% center;
    }

    .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(11, 15, 12, 0.78),
          rgba(11, 15, 12, 0.35)
        ),
        linear-gradient(
          0deg,
          rgba(11, 15, 12, 0.9) 0%,
          rgba(11, 15, 12, 0.3) 72%,
          rgba(11, 15, 12, 0.2) 100%
        );
    }

    .hero-content {
      padding-top: 7.5rem;
      padding-bottom: 7rem;
    }

    .hero-copy {
      padding-block: 2rem;
    }

    .hero-title {
      font-size: clamp(3.1rem, 12vw, 5.1rem);
    }

    .hero-description {
      max-width: 410px;
      font-size: 0.94rem;
    }

    .hero-side-note,
    .hero-index {
      display: none;
    }

    .hero-scroll {
      bottom: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      animation: none;
    }

    .scroll-indicator::after {
      animation: none;
    }
  }
</style>
