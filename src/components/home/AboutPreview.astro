---
import Button from "../ui/Button.astro";
---

<section class="section about-section">
  <div class="container about-layout">
    <div class="about-image-wrap interactive-image-wrap" data-reveal="left">
      <img
        src="https://images.unsplash.com/photo-1542038784456-1ea8e935640e?auto=format&fit=crop&w=1200&q=85"
        alt="Khemzy Studios photographer working with a camera during a portrait session"
        loading="lazy"
        width="1200"
        height="1400"
      />
      <div class="about-badge pulse-badge">
        <span class="badge-num">10+</span>
        <span class="badge-text">Years Crafting Visual Legacies</span>
      </div>
      <span class="about-image-label">THE ART OF INTENTION</span>
    </div>

    <div class="about-copy" data-reveal="right">
      <span class="eyebrow">BEHIND THE LENS</span>
      <h2>Creative vision.<br /><em>Personal connection.</em></h2>
      <p class="lead-text">
        At Khemzy Studios, photography is never about manufacturing artificial perfection.
        It is about discerning the subtle atmosphere, the unspoken bond, and the authentic
        gravitas of the subject.
      </p>
      <p>
        From the initial creative dialogue to the final retouched print, every parameter
        of light, color grading, and framing is considered with reverence. We don't just deliver
        digital files—we create photographic heirlooms that anchor memory.
      </p>

      <div class="about-stat-row" data-reveal="up">
        <div class="stat-box">
          <strong>350+</strong>
          <span>Weddings & Celebrations</span>
        </div>
        <div class="stat-box">
          <strong>1,200+</strong>
          <span>Portraits Captured</span>
        </div>
        <div class="stat-box">
          <strong>98%</strong>
          <span>Client Referrals</span>
        </div>
      </div>

      <div class="about-actions">
        <Button href="/about/" variant="dark" size="large">
          Read our studio story
        </Button>
        <a class="text-link" href="/contact/">
          <span>Visit our Lagos studio</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--color-paper);
    overflow: hidden;
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .about-image-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    aspect-ratio: 4 / 5;
  }

  .about-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-lg);
  }

  .about-badge {
    position: absolute;
    bottom: -1.5rem;
    right: -1.5rem;
    background: var(--color-ink);
    color: var(--color-white);
    padding: 1.25rem 1.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-gold);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-hover);
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-gold);
    line-height: 1;
  }

  .badge-text {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.25rem;
  }

  .about-image-label {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    font-weight: 600;
    color: var(--color-gold-light);
    background: rgba(16, 20, 17, 0.7);
    backdrop-filter: blur(8px);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
  }

  .about-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.5vw, 3.8rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0.75rem 0 1.5rem;
  }

  .about-copy h2 em {
    color: var(--color-gold);
    font-style: italic;
  }

  .lead-text {
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .about-copy p {
    color: var(--color-text-muted);
    font-size: 0.98rem;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .about-stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.25rem;
  }

  .stat-box strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
  }

  .stat-box span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
    }

    .about-badge {
      right: 1rem;
      bottom: 1rem;
    }
  }

  @media (max-width: 550px) {
    .about-stat-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
