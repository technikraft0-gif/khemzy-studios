---
import { siteConfig } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-cta" data-reveal="up">
    <div class="container footer-cta-inner">
      <div>
        <span class="eyebrow eyebrow--light">YOUR STORY STARTS HERE</span>
        <h2>Let's create something <em>unforgettable.</em></h2>
      </div>
      <div class="footer-cta-actions">
        <a class="button button--gold button--large" href="/booking/">
          <span>Start your booking</span>
          <span class="button-arrow" aria-hidden="true">↗</span>
        </a>
        <a
          class="button button--outline-light button--large"
          href={siteConfig.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Chat on WhatsApp</span>
          <span class="button-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-main" data-reveal="fade">
    <div class="footer-brand-block">
      <a class="brand brand--footer" href="/" aria-label="Khemzy Studios home">
        <span class="brand-name">Khemzy<span class="brand-period">.</span></span>
        <span class="brand-caption">STUDIOS</span>
      </a>
      <p>
        Photography with intention. Stories captured with feeling.
        Images made to last beyond the moment.
      </p>
      <div class="footer-social-links">
        {siteConfig.socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Follow Khemzy Studios on ${social.label}`}
          >
            {social.label}
          </a>
        ))}
      </div>
    </div>

    <div class="footer-column">
      <h3>Explore</h3>
      <a href="/portfolio/">Portfolio</a>
      <a href="/services/">Services</a>
      <a href="/about/">Our story</a>
      <a href="/pricing/">Pricing & Packages</a>
    </div>

    <div class="footer-column">
      <h3>Get in touch</h3>
      <a href="/booking/">Book a session</a>
      <a href="/contact/">Contact the studio</a>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a>
      <span class="footer-note">{siteConfig.address}</span>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {siteConfig.name}. All rights reserved.</p>
    <div class="footer-legal">
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms of Service</a>
    </div>
    <a class="back-to-top" href="#main-content">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .button--outline-light {
    color: var(--color-white);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .button--outline-light:hover {
    color: var(--color-ink);
    background: var(--color-white);
    border-color: var(--color-white);
  }

  .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .footer-social-links a {
    color: var(--color-gold-light);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-social-links a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
</style>
